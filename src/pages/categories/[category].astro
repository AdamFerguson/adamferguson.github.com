---
// /categories/{category}/ — all posts in one category.
import Base from "../../layouts/Base.astro";
import { url, slugOf } from "../../utils/url.mjs";
import { getCollection } from "astro:content";

// One static path per category that has at least one post.
export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const cats = new Set();
  for (const p of posts) if (p.data.category) cats.add(p.data.category);
  return [...cats].map((category) => ({ params: { category } }));
}

const { category } = Astro.params;
const decoded = decodeURIComponent(category);
const posts = (await getCollection("blog"))
  .filter((p) => p.data.category?.toLowerCase() === decoded.toLowerCase())
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function fmt(d) {
  return d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<Base title={`Category: ${decoded}`}>
  <section class="section">
    <h1 class="display">{decoded}</h1>
    <p class="lead">Posts in the <strong>{decoded}</strong> category.</p>
  </section>

  {posts.length === 0 ? (
    <p class="muted">No posts found in this category.</p>
  ) : (
    <ul class="post-list">
      {posts.map((post) => (
        <li class="card">
          <h2 class="post-title">
            <a href={url(`/blog/${slugOf(post.id)}/`)}>{post.data.title}</a>
          </h2>
          <p class="post__meta">
            <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
          </p>
          <p class="muted">{post.data.description}</p>
        </li>
      ))}
    </ul>
  )}
</Base>
