---
// Blog index: chronological list of published posts + archive.
import Base from "../../layouts/Base.astro";
import { url, slugOf } from "../../utils/url.mjs";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).filter((p) => !p.data.draft).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

function fmt(date) {
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<Base title="Blog">
  <section class="section">
    <h1 class="display">Blog</h1>
    <p class="lead">
      Notes on software, infrastructure, and the occasional detour.
    </p>
  </section>

  {posts.length === 0 ? (
    <p class="muted">
      No posts yet. Content is on its way — check back soon.
    </p>
  ) : (
    <ul class="post-list">
      {posts.map((post) => (
        <li class="card">
          <h2 class="post-title">
            <a href={url(`/blog/${slugOf(post.id)}/`)}>{post.data.title}</a>
          </h2>
          <p class="post__meta">
            <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
            {post.data.tags?.length > 0 && (
              <span> · {post.data.tags.join(", ")}</span>
            )}
          </p>
          <p class="muted">{post.data.description}</p>
        </li>
      ))}
    </ul>
  )}
</Base>
