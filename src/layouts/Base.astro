---
import { site, nav } from "../data/site.mjs";
import { url } from "../utils/url.mjs";
import { defaultTheme, defaultMode } from "../data/themes.mjs";
import PersonJsonLd from "../components/PersonJsonLd.astro";
const { title, description } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.title;
const theme = defaultTheme;
const mode = defaultMode;
// Cloudflare Web Analytics (cookieless, same-vendor as hosting). The token is
// a build-time env var sourced from a CI secret — it never appears in this
// repo. Without it (local dev builds) the tag is simply not rendered.
const analyticsToken = process.env.CF_WEB_ANALYTICS_TOKEN;
// The dev-only theme switcher is included only in DEV builds, so it is
// tree-shaken out of production output and never ships to visitors.
const isDev = import.meta.env.DEV;
---
<!doctype html>
<html lang="en" data-theme={theme} data-mode={mode}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
    <title>{pageTitle}</title>
    <script is:inline>
      (function () {
        try {
          var r = document.documentElement;
          var t = localStorage.getItem("af-theme");
          var m =
            localStorage.getItem("af-mode") ||
            (matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light");
          if (t) r.setAttribute("data-theme", t);
          if (m) r.setAttribute("data-mode", m);
        } catch (e) {}
      })();
    </script>
    {analyticsToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: analyticsToken })}
      />
    )}
    <!-- is:global: these sheets define Tier-1/2 tokens and element-level
         rules that must apply to ALL page content, not just Base's own
         markup. Without it, Astro scopes every selector to this layout's
         scope id and page content (links, headings, lists, code) renders
         with UA defaults. -->
    <style is:global>
      @import "../styles/themes.css";
      @import "../styles/global.css";
      @import "../styles/print.css";
    </style>
  </head>
  <body>
    <PersonJsonLd />
    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="brand" href={url("/")} aria-label="home">
          <span class="brand__mark">AF</span>
          <span class="brand__name">Adam Ferguson</span>
        </a>
        <div class="site-header__actions">
          <nav class="site-nav" aria-label="Primary">
            <ul>
              {nav.map((item) => (
                <li>
                  <a href={url(item.href)}>{item.label}</a>
                </li>
              ))}
            </ul>
          </nav>
          <button type="button" class="mode-toggle" aria-label="Switch color mode">
          <svg
            class="mode-toggle__moon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
          <svg
            class="mode-toggle__sun"
            hidden
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="5" />
            <line x1="12" y1="1" x2="12" y2="3" />
            <line x1="12" y1="21" x2="12" y2="23" />
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
            <line x1="1" y1="12" x2="3" y2="12" />
            <line x1="21" y1="12" x2="23" y2="12" />
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
          </svg>
        </button>
        </div>
      </div>
    </header>
    <script type="module">
      import { initModeToggle } from "../scripts/mode-toggle.js";
      initModeToggle();
    </script>
    <main class="site-main wrap" id="main"><slot /></main>
    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <p>© {new Date().getFullYear()} {site.name}. Built with Astro.</p>
      </div>
    </footer>
    {isDev && (
      <script type="module">
        import { initThemeToggle } from "../scripts/theme-toggle.js";
        initThemeToggle();
      </script>
    )}
  </body>
</html>
