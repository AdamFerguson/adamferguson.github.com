{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "adam-ferguson",
  "main": "worker.js",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "adam-ferguson.com", "custom_domain": true },
    { "pattern": "www.adam-ferguson.com", "custom_domain": true }
  ]
}
