{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@components/*": ["src/components/*"],
      "@layouts/*": ["src/layouts/*"],
      "@data/*": ["src/data/*"],
      "@styles/*": ["src/styles/*"],
      "@content/*": ["src/content/*"]
    }
  },
  "include": [
    "src/**/*",
    "scripts/**/*",
    "astro.config.mjs",
    "content.config.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
